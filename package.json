{
  "name": "rakuten_app",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "clear": "./scripts/clear_data.sh && adb shell pm clear com.android.chrome",
    "install:all": "yarn install:pointclub && yarn install:toshiru && yarn install:superpointscreen",
    "install:kuji": "adb install-multiple apps/R_Kuji/config.xxhdpi.apk apps/R_Kuji/config.arm64_v8a.apk apps/R_Kuji/jp.co.rakuten.rakutenluckykuji.apk",
    "install:pointclub": "adb install-multiple apps/R_PointClub/config.mdpi.apk apps/R_PointClub/jp.co.rakuten.pointclub.android.apk",
    "install:toshiru": "adb install-multiple apps/R_Toshiru/config.mdpi.apk apps/R_Toshiru/jp.co.rakutensec.toshiru.apk",
    "install:superpointscreen": "adb install apps/R_SuperPointScreen.apk",
    "test:pointclub": "yarn install:pointclub && npx wdio run wdio.apps.pointclub.conf.js",
    "test:superpointscreen": "yarn install:superpointscreen && npx wdio run wdio.apps.superpointscreen.conf.js",
    "test:kuji": "npx wdio run wdio.apps.kuji.conf.js",
    "test:toshiru": "yarn install:toshiru && npx wdio run wdio.apps.toshiru.conf.js",
    "test:pointclub_toshiru": "yarn install:pointclub && yarn install:toshiru && npx wdio run wdio.apps.pointclub_toshiru.conf.js",
    "test": "npx wdio run wdio.conf.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@wdio/cli": "^10.1.0"
  },
  "devDependencies": {
    "@wdio/appium-service": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "typescript": "^7.0.2",
    "@wdio/globals": "^10.1.0",
    "@wdio/types": "^10.1.0",
    "webdriverio": "^10.1.0",
    "@types/node": "^26.6.5",
    "appium": "^3.8.0",
    "expect-webdriverio": "^8.0.0",
    "appium-uiautomator2-driver": "^8.7.0",
    "puppeteer-core": "^25.16.0",
    "@wdio/protocols": "^10.0.2"
  },
  "engines": {
    "node": "^26.12.1"
  }
}
