{
  "name": "rakuten-point-playwright",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:campaign": "playwright test campaign.point",
    "test:card": "playwright test card.point",
    "test:kuji": "playwright test kuji.point",
    "test:infoseek": "playwright test infoseek.point",
    "check": "tsc --noEmit",
    "test:checks": "playwright test --config=playwright.checks.config.ts",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3"
  }
}
